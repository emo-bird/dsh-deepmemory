{
  "name": "@emo-bird/dsh-deepmemory",
  "version": "0.1.0",
  "private": true,
  "description": "Deep memory for DeepSeek Harness: facts, episodes and daily diary kept in one local SQLite file, with a sidebar console.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.js",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/store.test.mjs && node test/search.test.mjs && node test/settings.test.mjs && node test/diary.test.mjs && node test/toolkit.test.mjs && node test/scheduler.test.mjs",
    "install-embed": "node scripts/install-embed.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT"
}
